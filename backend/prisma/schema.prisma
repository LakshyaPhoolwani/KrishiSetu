generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  FARMER
  FPO
  BUYER
  ADMIN
  QUALITY_ASSESSOR
  LOGISTICS
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum EntityStatus {
  ACTIVE
  INACTIVE
  PENDING
}

enum LotStatus {
  DRAFT
  READY_FOR_MARKET
  LISTED
  MATCHED
  SOLD
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum AreaUnit {
  ACRE
  HECTARE
}

enum QuantityUnit {
  KG
  QUINTAL
  TON
}

enum PriceSourceType {
  LIVE
  DEMO
}

enum PriceUnit {
  INR_PER_QUINTAL
}

enum BuyerType {
  PROCESSOR
  RETAILER
  WHOLESALER
  TRADER
  EXPORTER
  OTHER
}

enum BuyerStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum BuyerDemandStatus {
  DRAFT
  ACTIVE
  PAUSED
  FULFILLED
  EXPIRED
  CANCELLED
}

model User {
  id          String     @id @default(cuid())
  clerkUserId String?    @unique
  name        String?
  email       String?    @unique
  phone       String?
  role        Role       @default(FARMER)
  status      UserStatus @default(ACTIVE)
  farmer      Farmer?
  buyer       Buyer?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([role])
  @@map("users")
}

model Farmer {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fpoId             String?
  fpo               FPO?     @relation(fields: [fpoId], references: [id], onDelete: SetNull)
  preferredLanguage String?
  district          String?
  state             String?
  latitude          Float?
  longitude         Float?
  farms             Farm[]
  lots              Lot[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([fpoId])
  @@map("farmers")
}

model FPO {
  id             String       @id @default(cuid())
  name           String
  registrationId String?      @unique
  phone          String?
  email          String?
  district       String?
  state          String?
  latitude       Float?
  longitude      Float?
  status         EntityStatus @default(PENDING)
  farmers        Farmer[]
  lots           Lot[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("fpos")
}

model Farm {
  id        String   @id @default(cuid())
  farmerId  String
  farmer    Farmer   @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  name      String
  address   String?
  village   String?
  district  String?
  state     String?
  pincode   String?
  latitude  Float?
  longitude Float?
  area      Decimal  @db.Decimal(12, 4)
  areaUnit  AreaUnit
  lots      Lot[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([farmerId])
  @@map("farms")
}

model Crop {
  id        String        @id @default(cuid())
  name      String
  variety   String?
  category  String?
  season    String?
  lots      Lot[]
  prices    MarketPrice[]
  demands   BuyerDemand[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([name])
  @@index([category])
  @@map("crops")
}

model Buyer {
  id           String        @id @default(cuid())
  userId       String        @unique
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName String
  buyerType    BuyerType     @default(OTHER)
  contactName  String?
  phone        String?
  email        String?
  address      String?
  district     String?
  state        String?
  latitude     Float?
  longitude    Float?
  status       BuyerStatus   @default(PENDING_VERIFICATION)
  demands      BuyerDemand[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status])
  @@index([buyerType])
  @@map("buyers")
}

model Market {
  id                         String                      @id @default(cuid())
  name                       String
  mandiCode                  String?                     @unique
  address                    String?
  district                   String?
  state                      String?
  latitude                   Float?
  longitude                  Float?
  active                     Boolean                     @default(true)
  status                     EntityStatus                @default(ACTIVE)
  prices                     MarketPrice[]
  demands                    BuyerDemand[]
  netRealisationCalculations NetRealisationCalculation[]
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt

  @@index([state])
  @@index([district])
  @@index([active])
  @@map("markets")
}

model MarketPrice {
  id                         String                      @id @default(cuid())
  marketId                   String
  market                     Market                      @relation(fields: [marketId], references: [id], onDelete: Restrict)
  cropId                     String
  crop                       Crop                        @relation(fields: [cropId], references: [id], onDelete: Restrict)
  priceDate                  DateTime
  minPrice                   Decimal?                    @db.Decimal(18, 3)
  maxPrice                   Decimal?                    @db.Decimal(18, 3)
  modalPrice                 Decimal?                    @db.Decimal(18, 3)
  normalizedUnit             PriceUnit                   @default(INR_PER_QUINTAL)
  sourceUnit                 String
  source                     String
  sourceType                 PriceSourceType
  sourceRecordId             String
  fetchedAt                  DateTime
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  netRealisationCalculations NetRealisationCalculation[]

  @@unique([source, sourceRecordId])
  @@index([marketId, cropId, priceDate])
  @@index([source, sourceType])
  @@map("market_prices")
}

model Lot {
  id                         String                      @id @default(cuid())
  lotCode                    String                      @unique
  farmerId                   String
  farmer                     Farmer                      @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  farmId                     String
  farm                       Farm                        @relation(fields: [farmId], references: [id], onDelete: Restrict)
  cropId                     String
  crop                       Crop                        @relation(fields: [cropId], references: [id], onDelete: Restrict)
  fpoId                      String?
  fpo                        FPO?                        @relation(fields: [fpoId], references: [id], onDelete: SetNull)
  quantity                   Decimal                     @db.Decimal(18, 3)
  quantityUnit               QuantityUnit
  sowingDate                 DateTime?
  expectedHarvestDate        DateTime?
  actualHarvestDate          DateTime?
  cultivationArea            Decimal?                    @db.Decimal(12, 4)
  cultivationAreaUnit        AreaUnit?
  qualityGrade               String?
  qualityNotes               String?
  status                     LotStatus                   @default(DRAFT)
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  netRealisationCalculations NetRealisationCalculation[]

  @@index([farmerId, status, createdAt])
  @@index([farmId, status])
  @@index([cropId, status])
  @@map("lots")
}

model NetRealisationCalculation {
  id                     String       @id @default(cuid())
  lotId                  String
  lot                    Lot          @relation(fields: [lotId], references: [id], onDelete: Restrict)
  marketId               String
  market                 Market       @relation(fields: [marketId], references: [id], onDelete: Restrict)
  marketPriceId          String
  marketPrice            MarketPrice  @relation(fields: [marketPriceId], references: [id], onDelete: Restrict)
  saleQuantity           Decimal      @db.Decimal(18, 6)
  saleQuantityUnit       QuantityUnit
  saleQuantityQuintals   Decimal      @db.Decimal(18, 6)
  salePricePerQuintal    Decimal      @db.Decimal(18, 6)
  saleRevenue            Decimal      @db.Decimal(18, 2)
  transportCost          Decimal      @db.Decimal(18, 2)
  storageCost            Decimal      @db.Decimal(18, 2)
  commissionCost         Decimal      @db.Decimal(18, 2)
  packagingCost          Decimal      @db.Decimal(18, 2)
  expectedLossPercentage Decimal      @db.Decimal(8, 4)
  expectedLossCost       Decimal      @db.Decimal(18, 2)
  otherCosts             Decimal      @db.Decimal(18, 2)
  totalCosts             Decimal      @db.Decimal(18, 2)
  netRealisation         Decimal      @db.Decimal(18, 2)
  createdAt              DateTime     @default(now())

  @@index([lotId, createdAt])
  @@index([marketId, marketPriceId])
  @@map("net_realisation_calculations")
}

model BuyerDemand {
  id                 String            @id @default(cuid())
  buyerId            String
  buyer              Buyer             @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  cropId             String
  crop               Crop              @relation(fields: [cropId], references: [id], onDelete: Restrict)
  quantity           Decimal           @db.Decimal(18, 3)
  quantityUnit       QuantityUnit
  minimumQuantity    Decimal?          @db.Decimal(18, 3)
  preferredMarketId  String?
  preferredMarket    Market?           @relation(fields: [preferredMarketId], references: [id], onDelete: SetNull)
  preferredState     String?
  preferredDistrict  String?
  preferredLocation  String?
  minimumPrice       Decimal?          @db.Decimal(18, 3)
  maximumPrice       Decimal?          @db.Decimal(18, 3)
  qualityRequirement String?
  validFrom          DateTime
  validUntil         DateTime?
  status             BuyerDemandStatus @default(DRAFT)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([buyerId, status, createdAt])
  @@index([cropId, status])
  @@index([validFrom, validUntil])
  @@index([preferredMarketId])
  @@map("buyer_demands")
}
