  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.0.0",
    "tsx": "^4.20.4",
    "vitest": "^3.2.4"
  }
}
